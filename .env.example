APP_NAME=Tecnoservicios
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Producción: https:// (HTTPS forzado con APP_ENV=production)
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5310

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Dev: tecnoservicios. Los tests usan tecnoservicios_testing (forzado en phpunit.xml).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tecnoservicios
DB_USERNAME=root
DB_PASSWORD=

# Sesión, cache y cola en Redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Producción: el dominio padre compartido por front y API (p. ej. .example.com)
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Sanctum SPA (cookie): dominios del front que reciben sesión stateful
SANCTUM_STATEFUL_DOMAINS=localhost:5310,127.0.0.1:5310
CORS_ALLOWED_ORIGINS=http://localhost:5310,http://127.0.0.1:5310

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=tecnoservicios_cache_

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=tecnoservicios_

# Mail: Resend. Sale de noreply; las respuestas van a MAIL_REPLY_TO_ADDRESS.
MAIL_MAILER=resend
RESEND_API_KEY=
# Webhook de Resend apagado: la Etapa 1 no procesa eventos de entrega.
RESEND_ROUTES=false
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REPLY_TO_ADDRESS="administracion@example.com"
MAIL_REPLY_TO_NAME="${APP_NAME}"

# Supervisord (php artisan supervisor:sync)
SUPERVISOR_CONF_DIR=/etc/supervisor/conf.d
SUPERVISOR_RELOAD=auto
SUPERVISOR_PROGRAM_PREFIX=tecnoservicios
SUPERVISOR_PHP_BINARY=php
SUPERVISOR_USER=www-data

# Bug-report NexoSmart (GET /api/errors). Generar: openssl rand -hex 32
ERRORS_TOKEN=
