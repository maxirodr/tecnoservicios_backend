APP_NAME=Tecnoservicios
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Producción: https:// (HTTPS forzado con APP_ENV=production)
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5310
# IPs (o CIDR) de los proxies de confianza, separadas por coma; vacío = ninguno (SEG-04).
# Producción: la IP del nginx que está delante (p. ej. 127.0.0.1). Nunca *.
TRUSTED_PROXIES=
# Identidad (RN-IDE-26): dominios de mail permitidos para dar de alta usuarios, separados por coma. Vacío = sin restricción.
MAIL_DOMINIOS_PERMITIDOS=
# SOLO servidores de prueba: muestra el código de ingreso en pantalla en vez de mandarlo por mail.
# Con APP_ENV=production se ignora siempre.
IDENTIDAD_CODIGO_EN_PANTALLA=false

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Dev: tecnoservicios. Los tests usan tecnoservicios_testing (forzado en phpunit.xml).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tecnoservicios
DB_USERNAME=root
DB_PASSWORD=
# Segundos para conectar a MySQL. Con MySQL caído se intenta una sola vez por pedido (PU-202): la API
# responde 503 en ~DB_CONNECT_TIMEOUT (1 s → ~1,3 s; con 2 eran ~2,3 s). Un MySQL sano conecta en ms.
DB_CONNECT_TIMEOUT=1

# Sesión, cache y cola en Redis
SESSION_DRIVER=redis
# 90 días desde el último uso (ADR-015)
SESSION_LIFETIME=129600
SESSION_ENCRYPT=false
SESSION_PATH=/
# Producción: el dominio padre compartido por front y API (p. ej. .example.com)
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Sanctum SPA (cookie): dominios del front que reciben sesión stateful
SANCTUM_STATEFUL_DOMAINS=localhost:5310,127.0.0.1:5310
CORS_ALLOWED_ORIGINS=http://localhost:5310,http://127.0.0.1:5310

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Adjuntos (ADR-014): disco privado y tamaño máximo por archivo
ADJUNTOS_DISK=adjuntos
# Carpeta del disco adjuntos (vacío = storage/app/private). La integración E2E usa la suya.
# ADJUNTOS_ROOT=
ADJUNTOS_MAX_MB=20
ADJUNTOS_SUBIDAS_POR_MINUTO=30

# Carga inicial (importacion.md RN-IMP-12): carpeta privada de los .xlsx y los informes (vacío = storage/app/private/importacion)
# IMPORTACION_DIR=
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=tecnoservicios_cache_

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=tecnoservicios_
# Segundos: conectar y leer/escribir. Cortos para que nada espere minutos con Redis caído (PU-020)
REDIS_TIMEOUT=1
REDIS_READ_TIMEOUT=3

# Mail: Resend. Sale de noreply; las respuestas van a MAIL_REPLY_TO_ADDRESS.
MAIL_MAILER=resend
RESEND_API_KEY=
# Webhook de Resend apagado: la Etapa 1 no procesa eventos de entrega.
RESEND_ROUTES=false
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REPLY_TO_ADDRESS="administracion@example.com"
MAIL_REPLY_TO_NAME="${APP_NAME}"

# Supervisord (php artisan supervisor:sync)
SUPERVISOR_CONF_DIR=/etc/supervisor/conf.d
SUPERVISOR_RELOAD=auto
SUPERVISOR_PROGRAM_PREFIX=tecnoservicios
SUPERVISOR_PHP_BINARY=php
SUPERVISOR_USER=www-data

# Bug-report NexoSmart (GET /api/errors). Generar: openssl rand -hex 32
ERRORS_TOKEN=
# /api/health: un job pendiente más viejo que esto (s) en las colas mail/default = degraded (PU-021)
HEALTH_QUEUE_MAX_AGE=120
HEALTH_REQUESTS_PER_MINUTE=60
# Cache del límite del health: nunca redis (tiene que responder con Redis caído)
HEALTH_LIMIT_STORE=file
# /api/health: timeout (s) del único intento de conexión a la base (PU-139)
HEALTH_DB_TIMEOUT=1
